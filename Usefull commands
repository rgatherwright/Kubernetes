# Exit Shell: 
  exit or Ctrl+D
# split ps window
  Alt + Shifr + =
# Force Kill Frozen Exec
  kill -9 $(pidof kubectl)
# Set Alias in powershell of 'k' for kubectl
  Set-Alias -Name k -Value kubectl
# Output help to text file in powershell.
k create deploy -h | Out-File -FilePath .\Deploy.txt
 
# repeat command every second using PS Watch module
  Watch-Command { kubectl get pods } -Seconds 1
# repeat the command 3 times for get pods (linux)
  Watch -n  3 kubectl get pods
# Copy a file and rename the new file (linux)
  cp deploy.yaml deploy2.yaml

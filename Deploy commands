#Deployment commands

#Create a deployment with httpd image and 3 read replicas
  Kubectl create deployment --image=httpd --replicas=3
#Show deployments
  kubectl get deployments.apps
#edit deployments
  kubectl edit deployments.apps NAME
#delete a deployment and underlying resources
  kubectl delete deployments.apps NAME
#Describe yaml 
  kubectl describe deployments.apps NAME
#Create a pod in a particular namespace
  k run ryan-lab --image=nginx --namespace lab
#Set up port forwarding for a pod
  k port-forward pods/mealie-66d67cdc89-w87nl 9000
